load("//:version.bzl", "VERSION")
load("//pkg:defs.bzl", "brand_publish_plan")
load("@brando//:defs.bzl", "brand_icons", "brand_package", "brand_svgs", "brand_wordmark_glyphs")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@brando_pip//:requirements.bzl", "requirement")

package(default_visibility = ["//visibility:public"])

# brando's OWN brand (the self-brand): the GODFATHER marionette. brando dogfoods
# its own pipeline here — the mark construction is shapely CSG and EMISSION goes
# through @brando//marklib (the reusable layered-SVG / composite convention),
# exactly as a third-party brand (tomato-bazel) consumes brando.

# A tiny hermetic serif wordmark builder ("brando"), pure shapely — no fonts.
py_library(
    name = "wordmark_geom",
    srcs = ["wordmark_geom.py"],
    imports = ["."],
    deps = [
        "@brando//marklib:wordmark",
        requirement("shapely"),
    ],
)

# The marionette mark construction (shapely CSG) + marklib emission.
py_library(
    name = "gen_godfather_lib",
    srcs = ["gen_godfather.py"],
    imports = ["."],
    deps = [
        "@brando//marklib",
        requirement("shapely"),
    ],
)

py_binary(
    name = "gen_godfather",
    srcs = ["gen_godfather.py"],
    imports = ["."],
    deps = [
        "@brando//marklib",
        requirement("shapely"),
    ],
)

# Hermetic rasterizer (marklib Pillow helpers; supersampled PNGs). Emits both the
# mark-only variants and the mark + serif "brando" wordmark lockups.
py_binary(
    name = "raster_godfather",
    srcs = ["raster_godfather.py"],
    imports = ["."],
    deps = [
        ":gen_godfather_lib",
        ":wordmark_geom",
        "@brando//marklib:raster",
        requirement("pillow"),
        requirement("shapely"),
    ],
)

# v2 mark construction (shapely CSG): the GODFATHER marionette now WITH THE HAND
# gripping the control bar. Reuses gen_godfather's artifact-glyph CSG so the two
# marks share one brand-artifact vocabulary; emission goes through @brando//marklib.
py_binary(
    name = "gen_godfather_v2",
    srcs = ["gen_godfather_v2.py"],
    imports = ["."],
    deps = [
        ":gen_godfather_lib",
        "@brando//marklib",
        requirement("shapely"),
    ],
)

py_library(
    name = "gen_godfather_v2_lib",
    srcs = ["gen_godfather_v2.py"],
    imports = ["."],
    deps = [
        ":gen_godfather_lib",
        "@brando//marklib",
        requirement("shapely"),
    ],
)

# v2 hermetic rasterizer: composites the hand + halo layer stack. Emits the v2
# mark-only variants and the v2 mark + serif "brando" wordmark lockups.
py_binary(
    name = "raster_godfather_v2",
    srcs = ["raster_godfather_v2.py"],
    imports = ["."],
    deps = [
        ":gen_godfather_v2_lib",
        ":wordmark_geom",
        "@brando//marklib:raster",
        requirement("pillow"),
        requirement("shapely"),
    ],
)

# brando self-brand layered SVGs.
#
# These lists are now the ONLY copy: brand_svgs computes the outs from them and
# passes them to the generator as --variant/--layer, so gen_godfather.py no longer
# carries a LAYERS constant for a human to copy over here. The "keep these lists
# in sync" comment that used to live on this block is gone with the second list.
_BG_VARIANTS = [
    "inkbg",
    "inkbg_grad",
]

_VARIANTS = _BG_VARIANTS + ["transparent"]

_LAYERS = [
    "svg",
    "strings.svg",
    "bar.svg",
    "artifacts.svg",
]

brand_svgs(
    name = "brando_svgs",
    # Real structure, not an exception to paper over: a background layer only
    # exists for the variants that HAVE a background. Stating it beats bending
    # the grid to pretend "transparent" has one.
    extra_outs = ["brando_%s.bg.svg" % v for v in _BG_VARIANTS],
    generator = ":gen_godfather",
    layers = _LAYERS,
    prefix = "brando",
    variants = _VARIANTS,
)

# brando self-brand avatar PNGs (square, 512 + 1024), rasterized hermetically.
_PNG_MARK_VARIANTS = [
    "inkbg",
    "inkbg_grad",
    "transparent",
]

_PNG_WORDMARK_VARIANTS = [
    "wordmark",
    "wordmark_transparent",
]

_PNG_SIZES = [
    512,
    1024,
]

brand_icons(
    name = "brando_icons",
    prefix = "brando",
    rasterizer = ":raster_godfather",
    sizes = _PNG_SIZES,
    variants = _PNG_MARK_VARIANTS + _PNG_WORDMARK_VARIANTS,
)

# ---- v2 self-brand assets (the GODFATHER marionette WITH THE HAND) ----
# Same variant/layer/size vocabulary as v1, with a "hand" layer added and the
# composite-only "handhalo" omitted (it is emit_file=False, so no file exists).
_V2_LAYERS = [
    "svg",
    "strings.svg",
    "bar.svg",
    "hand.svg",
    "artifacts.svg",
]

brand_svgs(
    name = "brando_v2_svgs",
    extra_outs = ["brando_v2_%s.bg.svg" % v for v in _BG_VARIANTS],
    generator = ":gen_godfather_v2",
    layers = _V2_LAYERS,
    prefix = "brando_v2",
    variants = _VARIANTS,
)

brand_icons(
    name = "brando_v2_icons",
    prefix = "brando_v2",
    rasterizer = ":raster_godfather_v2",
    sizes = _PNG_SIZES,
    variants = _PNG_MARK_VARIANTS + _PNG_WORDMARK_VARIANTS,
)

# ---- brando's CANONICAL mark: the vectorized Marlon Brando portrait ----
# A traced vector ASSET (AI stencil -> potrace -> svgo -> composite; see
# portrait/REGEN.md), NOT a marklib mark. This is the repo/org avatar
# (portrait/brando_avatar_1024.png, black-on-cream). The marionette targets above
# remain as the marklib pipeline dogfood.
filegroup(
    name = "portrait",
    srcs = glob(["portrait/**"]),
)

# ---- brando's wordmark + lockup, via the CONSTRUCTED-glyph path ----
# The dogfood for brand_wordmark_glyphs. brando's serif "brando" is shapely CSG,
# not a typeface, so the fontTools path cannot render it — which is aion's exact
# situation, and why aion hand-rolled 143 lines before marklib:wordmark existed.
py_binary(
    name = "gen_wordmark",
    srcs = ["gen_wordmark.py"],
    imports = ["."],
    deps = [
        ":gen_godfather_lib",
        ":wordmark_geom",
        "@brando//marklib",
        "@brando//marklib:wordmark",
        requirement("shapely"),
    ],
)

brand_wordmark_glyphs(
    name = "brando_wordmark_svgs",
    generator = ":gen_wordmark",
    outs = [
        "brando_wordmark_dark.svg",
        "brando_wordmark_light.svg",
        "brando_lockup_dark.svg",
        "brando_lockup_light.svg",
    ],
)

# ---- brando's own .brando archive ----
#
# The dogfood for brand_package, and the first .brando anywhere. It replaces
# nothing here because brando had no asset bundle; the two brands that DID have
# one (aion-brand-assets.zip, tbzl-brand-assets.zip) hand-assembled it with
# copy-pasted pkg_files blocks, two different layouts, and no manifest inside.
#
# The keys are the LOGICAL names a consumer asks for. They are a stable API —
# rules_brand exposes each one as a target — so they deliberately do not encode
# brando's internal filenames.
brand_package(
    name = "brando_package",
    assets = {
        "theme.binpb": {
            "kind": "ARTIFACT_KIND_THEME_BINPB",
            "label": "//skins:brando_binpb",
        },
        "theme.json": {
            "kind": "ARTIFACT_KIND_THEME_JSON",
            "label": "//skins:brando_json",
        },
        "mark.svg": {
            "kind": "ARTIFACT_KIND_MARK_SVG",
            "label": "brando_v2_transparent.svg",
            "variant": "transparent",
        },
        "mark-inkbg.svg": {
            "kind": "ARTIFACT_KIND_MARK_SVG",
            "label": "brando_v2_inkbg.svg",
            "variant": "inkbg",
        },
        "icon-512.png": {
            "kind": "ARTIFACT_KIND_MARK_PNG",
            "label": "brando_v2_transparent_512.png",
            "size_px": 512,
            "variant": "transparent",
        },
        "icon-1024.png": {
            "kind": "ARTIFACT_KIND_MARK_PNG",
            "label": "brando_v2_transparent_1024.png",
            "size_px": 1024,
            "variant": "transparent",
        },
        "wordmark-dark.svg": {
            "kind": "ARTIFACT_KIND_WORDMARK",
            "label": "brando_wordmark_dark.svg",
            "mode": "dark",
        },
        "wordmark-light.svg": {
            "kind": "ARTIFACT_KIND_WORDMARK",
            "label": "brando_wordmark_light.svg",
            "mode": "light",
        },
        "lockup-dark.svg": {
            "kind": "ARTIFACT_KIND_LOCKUP",
            "label": "brando_lockup_dark.svg",
            "mode": "dark",
        },
        "lockup-light.svg": {
            "kind": "ARTIFACT_KIND_LOCKUP",
            "label": "brando_lockup_light.svg",
            "mode": "light",
        },
        "fonts/SpaceGrotesk-Medium.ttf": {
            "kind": "ARTIFACT_KIND_FONTS",
            "label": "//fonts:SpaceGrotesk-Medium.ttf",
        },
        "fonts/OFL.txt": {
            "kind": "ARTIFACT_KIND_FONTS",
            "label": "//fonts:OFL.txt",
        },
    },
    brando_version = VERSION,
    source_repo = "mattmarshall/brando",
    spec = "brando.textproto",
)

# brando's own package on the CDN, and the pin a consumer must use.
brand_publish_plan(
    name = "brando_publish",
    package = ":brando_package",
    base_url = "https://github.com/mattmarshall/brando/releases/download/v0.4.0",
    prefix = "",
    brand = "brando",
    version = VERSION,
)
