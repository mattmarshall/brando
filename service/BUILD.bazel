"""The brando service tier.

PYTHON, and the reason is `render_core`. The fleet's four Bedrock callers are
Rust and the deploy lane is Rust-shaped, so Rust would be the consistent choice —
but `marklib` is Python, and "one library, two drivers" is the point of this
tier. A Rust front means a second process and an IPC hop on every render, and it
makes the byte-identical conformance test an integration test across a boundary
rather than a unit test over one function.

NOTHING HERE DEPLOYS ANYWHERE YET. brando is a personal project; after moving its
packages off a company CDN it would be strange to put its services on a company
cluster without deciding that first.
"""

load("@brando_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

# ── generated stubs ──────────────────────────────────────────────────────────
#
# rules_aip lints; it does not generate. This is the explicit codegen choice it
# leaves to the caller, driven from the descriptor set the lint gate already
# passed over.
py_binary(
    name = "gen_stubs",
    srcs = ["gen_stubs.py"],
    deps = [requirement("grpcio-tools")],
)

genrule(
    name = "stubs",
    srcs = ["//proto/brando/v1:brand_service_descriptor_set"],
    outs = [
        # meridian's Theme, which brand.proto imports. The generated
        # brand_pb2 does `from proto import theme_pb2`, so it has to be
        # generated alongside -- the descriptor set already carries it, because
        # proto_descriptor_set closes over imports.
        "proto/theme_pb2.py",
        "brando/v1/brand_pb2.py",
        "brando/v1/brand_service_pb2.py",
        "brando/v1/brand_service_pb2_grpc.py",
    ],
    cmd = (
        "$(execpath :gen_stubs) " +
        "--descriptor_set $(execpath //proto/brando/v1:brand_service_descriptor_set) " +
        "--out_dir $(RULEDIR) " +
        "--proto proto/theme.proto " +
        "--proto brando/v1/brand.proto --proto brando/v1/brand_service.proto"
    ),
    tools = [":gen_stubs"],
)

py_library(
    name = "brando_py_proto",
    srcs = [":stubs"],
    imports = ["."],
    deps = [
        requirement("googleapis-common-protos"),
        requirement("grpcio"),
        requirement("protobuf"),
    ],
)

py_library(
    name = "render_core",
    srcs = ["render_core.py"],
    imports = [".."],
    deps = [
        "//marklib:palette",
        # The MarkProgram interpreter, so RenderService can execute a mark that
        # lives IN a spec rather than being named by it. It is the one dep here
        # that is not stdlib -- it pulls shapely and svgwrite -- which is why
        # `render_mark` imports it INSIDE the function: a caller checking a
        # palette or projecting a stylesheet never loads the geometry stack, the
        # same property `marklib/__init__.py` defends with PEP 562.
        "//marklib:program",
        "//marklib:tokens",
        # Imported for `_blob_path`. A second definition of where a blob lives
        # inside an archive is how the manifest and the archive disagree.
        "//tools:pack_brand_lib",
    ],
)

# Every brand's REAL rule outputs, passed in by env. Listing them explicitly is
# what lets `test_every_brand_is_actually_checked` fail when one goes missing —
# a coverage gate that silently checks less is worse than no gate.
_BRAND_JSON = {
    "brando": "//skins:brando_json",
    "leangres": "//examples/leangres:leangres_skin_json",
    "citizen_sh": "//examples/citizen_sh:citizen_sh_skin_json",
    "resumarsh": "//examples/resumarsh:resumarsh_skin_json",
}

_BRAND_CSS = {
    "brando": "//selfbrand:brando_css",
    "leangres": "//examples/leangres:leangres_css",
    "citizen_sh": "//examples/citizen_sh:citizen_sh_css",
    "resumarsh": "//examples/resumarsh:resumarsh_css",
}

py_library(
    name = "studio",
    srcs = ["studio.py"],
    imports = [".."],
    deps = [":render_core"],
)

py_test(
    name = "studio_test",
    size = "small",
    srcs = ["studio_test.py"],
    imports = [".."],
    deps = [":studio"],
)

py_library(
    name = "server_lib",
    srcs = ["server.py"],
    imports = [".."],
    deps = [
        ":brando_py_proto",
        ":render_core",
        ":studio",
        requirement("grpcio"),
        requirement("protobuf"),
    ],
)

py_binary(
    name = "server",
    srcs = ["server.py"],
    imports = [".."],
    main = "server.py",
    deps = [":server_lib"],
)

py_test(
    name = "server_test",
    size = "small",
    srcs = ["server_test.py"],
    imports = [".."],
    deps = [
        ":brando_py_proto",
        ":server_lib",
    ],
)

py_test(
    name = "conformance_test",
    size = "small",
    srcs = ["conformance_test.py"],
    data = _BRAND_JSON.values() + _BRAND_CSS.values(),
    env = {
        "%s_JSON" % k.upper(): "$(rootpath %s)" % v
        for k, v in _BRAND_JSON.items()
    } | {
        "%s_CSS" % k.upper(): "$(rootpath %s)" % v
        for k, v in _BRAND_CSS.items()
    },
    imports = [".."],
    deps = [
        ":render_core",
        "//marklib:palette",
    ],
)
