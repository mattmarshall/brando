\ProvidesPackage{beamertheme@CLASSNAME@}[2026/06/29 brando beamer theme]

\RequirePackage{fontspec}
\RequirePackage{tikz}

% Brand typeface — brand_doc stages the fonts at fonts/.
\setsansfont{@MAINFONT@}[Path=fonts/, BoldFont=@BOLDFONT@]
\usefonttheme{professionalfonts}

% Brand palette (parameterized by brando's brand_latex_class).
\definecolor{brandbg}{HTML}{@BG@}
\definecolor{brandfg}{HTML}{@FG@}
\definecolor{brandaccent}{HTML}{@ACCENT@}
\definecolor{brandmuted}{HTML}{@MUTED@}

\setbeamercolor{background canvas}{bg=brandbg}
\setbeamercolor{normal text}{fg=brandfg}
\setbeamercolor{structure}{fg=brandaccent}
\setbeamercolor{title}{fg=brandfg}
\setbeamercolor{frametitle}{fg=brandfg}
\setbeamercolor{itemize item}{fg=brandaccent}
\setbeamercolor{itemize subitem}{fg=brandmuted}
\setbeamercolor{block title}{fg=brandbg, bg=brandaccent}
\setbeamercolor{block body}{fg=brandfg, bg=brandmuted!25}

\setbeamerfont{frametitle}{series=\bfseries, size=\Large}
\setbeamerfont{title}{series=\bfseries, size=\Huge}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{itemize item}{\small\raisebox{0.15ex}{$\blacktriangleright$}}

% Frame title with an accent underline.
\setbeamertemplate{frametitle}{%
  \vskip0.7em
  {\usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}\insertframetitle}%
  \vskip0.15em
  {\color{brandaccent}\rule{\linewidth}{1.2pt}}%
}

% Quiet footline: wordmark text + slide number.
\setbeamertemplate{footline}{%
  \hfill{\color{brandmuted}\scriptsize\textbf{@WORDMARK@}\quad\insertframenumber}%
  \hspace{1.2em}\vskip0.5em
}

\endinput
