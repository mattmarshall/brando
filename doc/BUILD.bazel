load(":defs.bzl", "brand_doc", "brand_latex_class", "brand_resources")

package(default_visibility = ["//visibility:public"])

# The templated brand LaTeX class / beamer theme / one-pager class. A brand
# instantiates these with its palette + fonts via brand_latex_class (defs.bzl).
exports_files(glob(["templates/*.tmpl"]) + ["defs.bzl"])

filegroup(
    name = "templates",
    srcs = glob(["templates/*.tmpl"]),
)

# brando's dogfood of brand_latex_class.
#
# Like brand_skin before 0.2.0, this rule had NO in-repo caller — and an
# unexercised rule is an untested rule; that is precisely how brand_skin came to
# resolve its schema from the consumer's repo mapping, and how brand_iconcomposer
# shipped a KeyError for two releases. Building this proves the class renders from
# a skin, that --strip_hash produces the bare 6-hex xcolor wants, and that a
# renamed token fails the build rather than shipping a literal "@ACCENT@".
brand_latex_class(
    name = "fixture_class",
    bold_font = "SpaceGrotesk-SemiBold.ttf",
    classname = "brandofixture",
    main_font = "SpaceGrotesk-Medium.ttf",
    skin = "//skins:fixture_json",
)

# The resource bundle brando's own fixture doc needs: the generated class plus
# the shared faces the class names.
brand_resources(
    name = "fixture_resources",
    srcs = [
        ":fixture_class",
        "//fonts:SpaceGrotesk-Medium.ttf",
        "//fonts:SpaceGrotesk-SemiBold.ttf",
    ],
)

# brando's dogfood of brand_doc. Rendering a template proves the template
# renders; only COMPILING a document that calls its macros proves the macros
# exist. 0.2.0's fv->brand rename passed every test here and broke a consumer's
# CI with "Undefined control sequence" — this is the gate that would have caught it.
brand_doc(
    name = "fixture_doc",
    main = "testdata/fixture.tex",
    resources = ":fixture_resources",
)

# The BEAMER half of the dogfood. //doc:fixture_doc compiles the article class and
# caught one half of 0.2.0's rename; the beamer theme's colours went unexercised
# and broke a consumer with "Undefined color `fvslate'". A rule that emits three
# files needs a fixture per file.
brand_doc(
    name = "fixture_deck",
    main = "testdata/fixture_deck.tex",
    resources = ":fixture_resources",
)
