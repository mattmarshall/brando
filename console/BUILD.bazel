"""brando console — a browsable catalog of every brand in the fleet.

The Phase 4 seed, built against what exists today. The console the plan describes
reads `.brando` archives over a gRPC BrandService; neither exists yet, so this
reads the artifact that does — the `<brand>.json` each brand_skin already emits.
When the services land, the data source swaps and the page does not.

Run it over the built skins of every brand:

    bazel run //console:build -- \
      --skin aion=/path/to/aion.json --mark aion=/path/to/aion_mark.glyph.svg \
      --skin fastverk=... \
      --out /tmp/console/index.html
    python3 -m http.server -d /tmp/console 8731

brando cannot depend on the brand repos, so the skins are inputs rather than deps
— which is the same shape a BrandService call will have.
"""

load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "build_console_lib",
    srcs = ["build_console.py"],
    imports = [".."],
    deps = [
        "//marklib:palette",
        "//marklib:tokens",
    ],
)

py_binary(
    name = "build",
    srcs = ["build_console.py"],
    imports = [".."],
    main = "build_console.py",
    deps = [
        "//marklib:palette",
        "//marklib:tokens",
    ],
)

py_test(
    name = "build_console_test",
    size = "small",
    srcs = ["build_console_test.py"],
    imports = [".."],
    deps = [":build_console_lib"],
)

# ── the published site ───────────────────────────────────────────────────────
#
# brando's brands, rendered as one self-contained page. The builder inlines each
# mark's SVG, so the output has no external references at all — which is what
# makes GitHub Pages the right host: static, versioned with the repo, and needing
# no infrastructure. The same reasoning that moved packages onto Releases.
#
# The plan originally had this as a meridian PanelBundle rendered by the fastverk
# console shell. That would have made a personal project depend on savvifi's
# console deployment to show its own brands, which is the wrong shape regardless
# of how good the shell is.
#
# Every brand is listed HERE rather than globbed, and that is a boundary rather
# than a style preference. This page is PUBLIC. The console can render any brand
# whose skin JSON it is handed, and the fleet's other brands — aion, savvi,
# fastverk, meridian, tomato — belong to savvifi and other orgs. A glob over
# whatever skins happen to be reachable would publish someone else's identity on
# a personal repo's website the first time a dependency brought one into the
# graph. An explicit list makes that a deliberate line, not a side effect.
_BRANDS = {
    "brando": "//skins:brando",
    "leangres": "//examples/leangres:leangres_skin",
    "citizen_sh": "//examples/citizen_sh:citizen_sh_skin",
    "resumarsh": "//examples/resumarsh:resumarsh_skin",
}

_MARKS = {
    "brando": "//selfbrand:brando_v2_transparent.svg",
    "leangres": "//examples/leangres:leangres_transparent.svg",
    "citizen_sh": "//examples/citizen_sh:citizen_sh_transparent.svg",
    "resumarsh": "//examples/resumarsh:resumarsh_transparent.svg",
}

genrule(
    name = "site",
    srcs = ["%s_json" % v for v in _BRANDS.values()] + _MARKS.values(),
    outs = ["index.html"],
    cmd = (
        "$(execpath :build) --out $@ " +
        " ".join([
            "--skin %s=$(execpath %s_json)" % (k, v)
            for k, v in _BRANDS.items()
        ]) + " " +
        " ".join([
            "--mark %s=$(execpath %s)" % (k, v)
            for k, v in _MARKS.items()
        ])
    ),
    tools = [":build"],
    visibility = ["//visibility:public"],
)
