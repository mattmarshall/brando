"""brando.v1 — a brand as data.

Declared with `aip_proto_library` and gated by `aip_proto_lint`. rules_aip is a
LINTING toolkit, not a codegen one — its README says stub generation is
intentionally out of scope — so this package produces a `proto_library` and an
api-linter test, and any language bindings are a separate, explicit choice.

`strip_import_prefix = "/proto"` makes the import path match the proto package,
which is what lets AIP-191 pass unwaived.
"""

load("@rules_python//python:defs.bzl", "py_test")
load("//tools/proto:defs.bzl", "proto_descriptor_set")

# `brand_package` reads this from another package, and `rules_brand` consumers
# never see it — it is baked into the archive at pack time.
exports_files(["brand_schema.json"])
load("@rules_aip//aip:defs.bzl", "AIP_LRO_DEPS", "AIP_WKT_DEPS", "aip_proto_library", "aip_proto_lint")

package(default_visibility = ["//visibility:public"])

aip_proto_library(
    name = "brand_proto",
    srcs = ["brand.proto"],
    strip_import_prefix = "/proto",
    deps = AIP_WKT_DEPS + ["@meridian_schemas//proto:theme_proto"],
)

# The RESOURCE-ORIENTED surface. Separate target from `brand_proto` because the
# two earn different waivers: a data contract declares no services and so cannot
# satisfy AIP's method rules, while this file is exactly what those rules are for
# and should be held to them.
aip_proto_library(
    name = "brand_service_proto",
    srcs = ["brand_service.proto"],
    strip_import_prefix = "/proto",
    # LRO deps because RenderService and StudioService return Operations:
    # rendering runs the generators (CSG, rasterization, LaTeX) and a Bedrock
    # call is a network round trip. Both are operations from the start rather
    # than blocking RPCs that later need rewriting.
    deps = AIP_WKT_DEPS + AIP_LRO_DEPS + [":brand_proto"],
)

aip_proto_lint(
    name = "brand_service_proto_aip_lint",
    proto = ":brand_service_proto",
    disable_rules = [
        # These two fire ~200 times, and 120 + 86 of those are in the
        # TRANSITIVELY INCLUDED brand.proto rather than in this file: the linter
        # walks the whole descriptor set, so a dependency's findings surface
        # through its dependent. brand.proto has its own lint target and its own
        # considered waivers for exactly these; re-deciding them here would mean
        # one file's rules are settled in two places. The findings that were
        # genuinely in THIS file were fixed rather than waived.
        "core::0203::field-behavior-required",
        "core::0192::has-comments",
        # AIP-127 wants `google.api.http` on every method, for REST transcoding.
        # These services are gRPC-only. Annotating them would declare a REST
        # surface nothing serves, which is a worse failure than not having one --
        # a generated client would offer URLs that 404. Add the annotations at
        # the point a gateway actually goes in front.
        "core::0127::http-annotation",
        # AIP-191 wants services before messages. This file groups each service
        # with the request and response messages only it uses, which is what
        # makes a 500-line API file readable; hoisting five service blocks to the
        # top would separate every method from its own types.
        "core::0191::file-layout",
    ],
)

aip_proto_lint(
    name = "brand_proto_aip_lint",
    proto = ":brand_proto",
    # These are the waivers an INTERNAL data contract earns; each one is a rule
    # about resource-oriented RPC surfaces, and this file declares no service.
    disable_rules = [
        # BrandSpec/BrandPackage are message types in an artifact format, not
        # AIP-123 resources with names and Get/List methods.
        "core::0123::resource-annotation",
        # AIP-192 wants a comment on every symbol; the ones here carry rationale
        # rather than restating the field name, and several fields are self-
        # evident members of an enum whose block comment explains the set.
        "core::0192::has-comments",
        # AIP-122 reserves `name` for resource names and so discourages the
        # `_name` suffix. `display_name` is the field meridian.theme.v1.Theme
        # already uses for exactly this, and BrandSpec mirrors that contract on
        # purpose — renaming it here would create the divergence this format
        # exists to prevent.
        "core::0122::name-suffix",
        # AIP-215 discourages referencing a type from another package. Reusing
        # `meridian.theme.v1.Theme` rather than redeclaring it is the central
        # design decision of this file: a second, subtly different Theme is the
        # precise failure mode brando 0.2.0 spent its release removing.
        "core::0215::foreign-type-reference",
    ],
)

test_suite(
    name = "aip_lint",
    tests = [":brand_proto_aip_lint"],
)

# A SELF-CONTAINED FileDescriptorSet (--include_imports pulls in the WKTs and
# meridian's theme.proto). brand_package feeds this to `protoc --encode` with
# --descriptor_set_in, so encoding a manifest needs no proto_path plumbing and no
# access to the .proto sources in the consuming build.
proto_descriptor_set(
    name = "brand_descriptor_set",
    proto = ":brand_proto",
)

# The schema map that lets STARLARK read a .brando manifest.
#
# rules_brand's repo rule has to know what is in a package to generate targets for
# it, and Starlark cannot parse protobuf — but it has json.decode. So a .brando
# carries the manifest twice: brand.binpb for anything with a proto runtime, and
# brand.json for Bazel. This is the map that produces the second, derived from the
# same descriptor set by the same generator the theme schema uses.
genrule(
    name = "brand_schema_regenerated",
    srcs = [":brand_descriptor_set"],
    outs = ["brand_schema.regenerated.json"],
    cmd = (
        "$(execpath //skins:regen_theme_schema) " +
        "--descriptor_set $(execpath :brand_descriptor_set) " +
        "--root brando.v1.BrandPackage --out $@"
    ),
    tools = ["//skins:regen_theme_schema"],
)

py_test(
    name = "brand_schema_test",
    size = "small",
    srcs = ["//skins:theme_schema_test.py"],
    data = [
        "brand_schema.json",
        ":brand_schema_regenerated",
    ],
    env = {
        "COMMITTED": "$(rootpath brand_schema.json)",
        "REGENERATED": "$(rootpath :brand_schema_regenerated)",
        "SCHEMA_KIND": "brand",
    },
    main = "theme_schema_test.py",
)
