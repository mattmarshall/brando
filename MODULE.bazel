# brando — the reusable, brand-neutral brand pipeline.
#
# brando is the machinery; a brand (fastverk, tomato-bazel, ...) supplies only
# CONTENT (its mark geometry, palette, fonts, wordmark text, skin textproto) and
# depends on brando as a Bazel module. One pipeline, many brands:
#
#   * marklib — the reusable mark-authoring Python library (shapely CSG helpers,
#     svgwrite layered-SVG / Icon Composer emission, the Pillow rasterizer) that
#     a brand's own gen_<mark>.py imports.
#   * brand_doc — a tectonic .tex -> PDF rule with a TEMPLATED brand LaTeX class
#     (colors/fonts passed as inputs, so any brand styles its docs identically).
#   * brand_skin — textpb -> binpb (protoc --encode against meridian's theme.proto)
#     -> json, the meridian-theme pipeline (brand authors the textproto only).
#   * brand_icons / brand_wordmark / brand_office / brand_mdbook_theme — packaging
#     rules + generators parameterized on the brand's palette/fonts/text.
#
# Hermetic: generators run in-build as py_binary (rules_python + a pip lock
# pulling shapely/svgwrite/pillow/fonttools/python-pptx/python-docx wheels).
module(
    name = "brando",
    version = "0.4.0",
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "rules_tectonic", version = "0.2.0")

# meridian_schemas — brando depends on it ONLY for the theme SCHEMA
# (@meridian_schemas//proto:theme.proto): brand_skin compiles a brand's Theme
# textproto against it (protoc --encode) into <brand>.binpb/json. brando pulls no
# renderer code; meridian stays brand-neutral. protobuf provides protoc.
#
# WHY meridian_schemas AND NOT THE RETIRED `meridian` MONOLITH. brand_skin used to
# name "@meridian//proto:theme.proto" as a PLAIN STRING inside native.genrule(srcs)
# -- and bzlmod resolves a plain-string label in a legacy macro with the repo
# mapping of the CALLING package, not brando's. So which schema validated a skin
# was decided by an accident of the consumer's dependency graph. A consumer with a
# `repo_name = "meridian"` alias got meridian_schemas; one without got brando's own
# meridian 0.2.3, whose 69-line theme.proto has NO `Typography.display` (field 7)
# and NO `repeated FontSource fonts` (field 8) -- so every skin that declares its
# own faces failed the --encode gate. aion had to fork these genrules into its own
# BUILD file to pin the schema by label.
#
# The fix is BOTH halves: depend on meridian_schemas here, and emit the label via
# Label() in skins/defs.bzl so resolution is brando's own. Changing only the label
# form would have pinned resolution to the WRONG (0.2.3) schema, deterministically.
#
# Pinned to 0.24.0, the first version brando can actually reach that carries
# Palette.warning (13) and Palette.info (14). Those fields landed in 0.20.0 and
# then sat unpublished — `rels release` derived the registry directory from the
# REPO basename (meridian-schemas) rather than the module's declared name
# (meridian_schemas), so five tagged releases wrote to a tree Bazel never looks
# in. Fixed and published 2026-08-05.
#
# Until then, zero of the six brand skins set warning or info, which read as
# neglect but was impossibility: meridian's ValueTone had nowhere to resolve
# NEEDS-ATTENTION or INFORMATIONAL and collapsed both to neutral on every surface.
# The bump is additive-only, so it costs consumers nothing but the MVS floor.
bazel_dep(name = "meridian_schemas", version = "0.24.0")
bazel_dep(name = "protobuf", version = "33.4")

# For ProtoInfo in //tools/proto. Loading it from @rules_proto rather than the
# bare global is deliberate: the global was removed in strict Bazel 9, and naming
# it caught meridian out at its own registry publish.
bazel_dep(name = "rules_proto", version = "7.1.0")

# rules_aip — AIP proto linting for brando.v1 (the .brando package format). It is
# a LINTING toolkit only; its README puts stub generation explicitly out of scope,
# so this brings an api-linter test and the googleapis dep groups, nothing more.
# >= 0.3.0 takes protoc from the proto toolchain rather than naming
# @protobuf//:protoc directly, which is what keeps a C++ toolchain out of repos
# that have no C++ in them.
bazel_dep(name = "rules_aip", version = "0.3.0")

# The google.api.* annotation protos aip_proto_library bundles. Via bazel_dep, so
# nothing is vendored into the graph — the same pin governor and meridian-k8s use.
bazel_dep(name = "googleapis", version = "0.0.0-20260422-20ac242a")

# ─── tectonic (brand PDFs) ──────────────────────────────────────────
tectonic = use_extension("@rules_tectonic//tectonic:extensions.bzl", "tectonic")
use_repo(tectonic, "tectonic")

register_toolchains("@tectonic//:tectonic_toolchain_def")

# ─── hermetic Python (the generators) ───────────────────────────────
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)
use_repo(python, "python_3_12")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "brando_pip",
    python_version = "3.12",
    requirements_lock = "//:requirements.txt",
)
use_repo(pip, "brando_pip")
